  "vehicles": {
    "about": "Bodies of the vehicles (gen/vehicles.js createClassifier): freight = goods name -> load kind (passenger, mail, none, box, tank, open, covered, reefer, stake, steel, container, autos, flat), else catg = goods category -> load kind; keywords (regular expressions on the pak name, first match of each kind wins) override the load, the locomotive kind or mark helicopters; families scale the bodies across (w) and up (h) per way type; locomotives without a keyword are steam before steamBefore, electric from electricFrom at 140 km/h or more, else diesel; ships are drawn scale times their length (squares, between min and max); aircraft by capacity (seats up to upTo) with their drawn length in squares; city cars by colour words in their name.",
    "freight": { "Passagiere": "passenger", "Post": "mail", "Autos": "autos", "Cement": "covered", "Concrete": "covered", "Stahl": "steel", "None": "none" },
    "catg": { "0": "box", "1": "box", "2": "open", "3": "tank", "4": "reefer", "5": "tank", "6": "stake", "7": "covered" },
    "keywords": [
      { "match": "container", "freight": "container" },
      { "match": "tender", "freight": "open" },
      { "match": "tank|kessel|tanker", "freight": "tank" },
      { "match": "hopper|silo|grain", "freight": "covered" },
      { "match": "steam|dampf", "loco": "steam" },
      { "match": "diesel|dmu", "loco": "diesel" },
      { "match": "electric|elektr|emu|_e[0-9]", "loco": "electric" },
      { "match": "heli", "air": "heli" }
    ],
    "families": {
